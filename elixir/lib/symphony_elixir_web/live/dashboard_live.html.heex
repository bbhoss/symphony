<div class="dashboard">
  <div class="header">
    <h1>Symphony Dashboard</h1>
    <button phx-click="refresh" class="refresh-btn">Refresh</button>
  </div>

  <div class="generated-at">
    Generated at: {@payload.generated_at}
  </div>

  <%= if Map.has_key?(@payload, :error) do %>
    <div class="error-banner">
      {@payload.error.code}: {@payload.error.message}
    </div>
  <% else %>
    <div class="counts">
      <span class="count running">Running: {@payload.counts.running}</span>
      <span class="count retrying">Retrying: {@payload.counts.retrying}</span>
    </div>

    <section :if={@payload.running != []} class="section">
      <h2>Running Agents</h2>
      <table>
        <thead>
          <tr>
            <th>Issue</th>
            <th>State</th>
            <th>Session</th>
            <th>Turns</th>
            <th>Tokens</th>
            <th>Started</th>
            <th>Last Event</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={agent <- @payload.running}>
            <td class="mono">{agent.issue_identifier}</td>
            <td>{agent.state}</td>
            <td class="mono">{truncate_session(agent.session_id)}</td>
            <td>{agent.turn_count}</td>
            <td>{format_number(agent.tokens.total_tokens)}</td>
            <td>{agent.started_at}</td>
            <td>{agent.last_event}</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section :if={@payload.retrying != []} class="section">
      <h2>Retrying Agents</h2>
      <table>
        <thead>
          <tr>
            <th>Issue</th>
            <th>Attempt</th>
            <th>Due At</th>
            <th>Error</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={agent <- @payload.retrying}>
            <td class="mono">{agent.issue_identifier}</td>
            <td>{agent.attempt}</td>
            <td>{agent.due_at}</td>
            <td class="error-text">{inspect(agent.error)}</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section :if={@payload.codex_totals} class="section">
      <h2>Codex Totals</h2>
      <div class="stats-grid">
        <div class="stat">
          <span class="stat-label">Input Tokens</span>
          <span class="stat-value">{format_number(@payload.codex_totals[:input_tokens] || @payload.codex_totals["input_tokens"] || 0)}</span>
        </div>
        <div class="stat">
          <span class="stat-label">Output Tokens</span>
          <span class="stat-value">{format_number(@payload.codex_totals[:output_tokens] || @payload.codex_totals["output_tokens"] || 0)}</span>
        </div>
        <div class="stat">
          <span class="stat-label">Total Tokens</span>
          <span class="stat-value">{format_number(@payload.codex_totals[:total_tokens] || @payload.codex_totals["total_tokens"] || 0)}</span>
        </div>
        <div class="stat">
          <span class="stat-label">Seconds Running</span>
          <span class="stat-value">{@payload.codex_totals[:seconds_running] || @payload.codex_totals["seconds_running"] || 0}</span>
        </div>
      </div>
    </section>

    <section :if={@payload.rate_limits && @payload.rate_limits != %{}} class="section">
      <h2>Rate Limits</h2>
      <pre class="json-block">{Jason.encode!(@payload.rate_limits, pretty: true)}</pre>
    </section>
  <% end %>
</div>
